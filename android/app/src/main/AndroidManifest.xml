<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- On-device model files live in SHARED storage (<sdcard>/Mirobody/models) so a
         multi-GB download/import survives an app uninstall/reinstall. API 30+ uses
         All-Files-Access; API 26–29 uses legacy external storage (see
         requestLegacyExternalStorage on <application>). Also covers the legacy
         MediaStore image-write path on pre-Q devices. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- The embedded C++ server runs in a foreground service (MirobodyService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- On-device health (data/health, HealthConnectSource). Read-only access to
         the four metrics we ingest; the user still grants each at runtime via the
         Health Connect permission flow. HMS Health Kit (Huawei) uses OAuth scopes,
         not these manifest permissions. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- Direct BLE GATT health sensors (data/health/ble, BleHealthController). On
         API 31+ scanning/connecting use the runtime BLUETOOTH_SCAN / BLUETOOTH_CONNECT
         permissions (neverForLocation: we don't derive location from beacons); on
         API 26–30 the legacy BLUETOOTH/BLUETOOTH_ADMIN (install-time) plus
         ACCESS_FINE_LOCATION (runtime, required for BLE scan) apply instead. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Android 11+ package visibility -->
    <queries>
        <!-- WeChat OpenSDK detect/launch for "Sign in with WeChat". -->
        <package android:name="com.tencent.mm" />
        <!-- Health Connect: lets HealthConnectClient resolve the provider app. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".MirobodyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mirobody"
        tools:targetApi="31">
        <!-- OpenCL is a VENDOR library, not part of the NDK. Since Android 12 an app
             targeting API 31+ may not dlopen one without saying so here, which is why
             LiteRT-LM's GPU backend reported "Can not find OpenCL library on this device"
             on a phone that plainly has one. required="false" because most devices are
             served fine without it: the GPU path is optional (see the probe), and a device
             with no OpenCL must still install and run on the CPU. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <!-- Vendor spellings of the same thing: Tensor ships libOpenCL-pixel.so and
             Mali exposes it through libGLES_mali.so. All optional, so a device with
             none of them is unaffected. -->
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libGLES_mali.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Mirobody">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MirobodyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Health Connect requires a permissions-rationale target before it will
             grant access. Add ONE of these pointing at a screen that explains why
             the app reads health data (required for Health Connect review):
               * Android 14+: an <intent-filter> on an activity with
                   action android.intent.action.VIEW_PERMISSION_USAGE
                   category android.intent.category.HEALTH_PERMISSIONS
               * Android 13-: an activity/alias with intent-filter
                   action androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE
             Left as a note rather than hijacking MainActivity's launch filter. -->

        <!-- HMS Health Kit (Huawei): the agconnect plugin injects the app id from
             agconnect-services.json. When wiring HMS, add:
               <meta-data android:name="com.huawei.hms.client.appid"
                          android:value="appid=YOUR_HUAWEI_APP_ID" /> -->


        <!-- WeChat OpenSDK callback. Must be exported and located at
             <applicationId>.wxapi.WXEntryActivity for WeChat to launch it. -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="ai.thetahealth.mirobody"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>
