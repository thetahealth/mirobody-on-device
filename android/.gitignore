# Android / Gradle build outputs
/build
/app/build
.gradle
.kotlin

# NDK / native build
.cxx
.externalNativeBuild
# Every prebuilt native artifact, from two producers: <abi>/ is the embedded server's
# cross-compiled C++ dependencies (build-prebuilt.cmd/.sh), llama-sdk/<abi>/ is the
# on-device engine (build-llama.cmd/.sh). One rule, because "prebuilt" naming anything
# less than all of them is how a reader ends up assuming the engine is in there.
/prebuilt
# llama.cpp cross-build tree for the on-device engine (build-llama.cmd/.sh). Cached and
# reused across runs, hence kept in-tree rather than in a temp dir; a few hundred MB of
# objects. The /build rules above do not catch it — the name is neither "build" nor
# under one.
/.llama-build

# IDE
.idea

# Local machine config and secrets
local.properties
*.jks
*.keystore
keystore.properties
