# Shell scripts must stay LF even on Windows checkout, or they break under
# bash on Linux / WSL (a CRLF in the shebang line is fatal).
*.sh text eol=lf
# Batch files are the mirror image and need CRLF, because cmd.exe resolves a
# `goto` / `call :label` by byte offset: in an LF-only file the seek can land
# mid-line and miss a label that is plainly there. It fails silently until an
# edit shifts the offsets, and then reports the label as not found -- which sent
# one afternoon looking for a typo in build-qt.cmd that was never there.
# core.autocrlf=input (what this repo assumes) normalizes them to LF on commit
# and never converts back, so the checkout side has to say it.
*.cmd text eol=crlf
*.bat text eol=crlf
# Reference data arrives from wherever it was exported -- the LOINC/benchmark
# sheets under fine-tuning/ came in CRLF -- and a delimited file whose line
# endings drift shows up as a whole-file diff that hides the one row that
# changed. core.autocrlf already normalizes on commit for anyone who has it set;
# this holds for everyone.
*.csv text eol=lf
*.tsv text eol=lf
