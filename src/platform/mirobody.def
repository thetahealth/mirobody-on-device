; Module-definition file for libmirobody on Windows. Restricts the DLL's export
; table to the public C ABI in src/mirobody.h, instead of dumping every C++
; symbol (which WINDOWS_EXPORT_ALL_SYMBOLS would). Keeps mirobody.h free of
; __declspec(dllexport) annotations and gives FFI hosts a clean, stable surface.
EXPORTS
    mirobody_start
    mirobody_stop
    mirobody_is_running
    mirobody_listen_port
    mirobody_set_config
    mirobody_reload_providers
    mirobody_get_providers
    mirobody_chat
    mirobody_chat_messages
    mirobody_chat_answer
    mirobody_chat_answer_cancel_all
    mirobody_store_file
    mirobody_list_files
    mirobody_read_file
    mirobody_health_store
    mirobody_health_recent
    mirobody_llm_available
    mirobody_llm_backend_path
    mirobody_llm_open
    mirobody_llm_close
    mirobody_llm_cancel
    mirobody_llm_load
    mirobody_llm_loaded
    mirobody_llm_generate
