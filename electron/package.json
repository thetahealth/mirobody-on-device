{
  "name": "mirobody-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop wrapper that embeds the mirobody C++ server in-process via koffi FFI and loads the web client.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.15.0"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "node-llama-cpp": "^3.0.0"
  },
  "build": {
    "appId": "ai.thetahealth.mirobody",
    "productName": "Mirobody",
    "files": [
      "main.js",
      "mirobody.js",
      "preload.js",
      "ondevice.js"
    ],
    "extraResources": [
      { "from": "../res/sql", "to": "res/sql" },
      { "from": "../res/htdoc", "to": "res/htdoc" },
      { "from": "../config.example.yml", "to": "config.example.yml" },
      {
        "from": "../build-shared",
        "to": "native",
        "filter": ["mirobody.dll", "libmirobody.so", "libmirobody.dylib"]
      }
    ]
  }
}
