/* Chat page, aligned to the web client's "Theta Health" design: warm cream
   surface, navy user bubbles, plain assistant text (no bubble), navy accents. */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f2efe9;
}

/* -- toolbar (hamburger + wordmark / centered subject picker / empty) ---- */
.toolbar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
}
/* Equal-width side zones: the trailing one carries no actions any more, but the
   matched pair is what keeps the centre element optically centred rather than
   shoved right by the hamburger. */
.tb-side {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
}
.tb-right {
  justify-content: flex-end;
}
/* The centre hosts only what the view puts there — the subject picker. */
.tb-center {
  flex: 0 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* The one menu affordance: opens the nav drawer (history, health, app settings,
   account). It replaced an account avatar — the drawer's body is the conversation
   list, so a profile glyph undersold what the button opens. */
.menu-btn {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 40rpx;
  color: #52565c;
}
.brand {
  flex: 0 1 auto;
  margin-left: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #0f1115;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.incognito-banner {
  margin: 0 0 20rpx;
  padding: 12rpx 18rpx;
  background: #faf7f1;
  border: 1px solid #ddd6c9;
  border-radius: 12rpx;
  color: #52565c;
  font-size: 24rpx;
}

/* -- message list -------------------------------------------------------- */
.log {
  flex: 1;
  padding: 8rpx 24rpx 24rpx;
  box-sizing: border-box;
}
.empty {
  margin-top: 26vh;
  text-align: center;
  color: #8a8f96;
  font-size: 30rpx;
}
.row {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}
.row.user {
  align-items: flex-end;
}
.row.assistant {
  align-items: flex-start;
}
.bubble {
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
}
/* User turn: a filled navy bubble with an asymmetric tail (like the web app). */
.bubble.user {
  max-width: 82%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  border-bottom-right-radius: 6rpx;
  background: #1e3a6b;
  color: #fff;
}
/* Assistant turn: plain text on the surface, no bubble/border. */
.bubble.assistant {
  max-width: 100%;
  color: #1a1c1e;
}
.thinking {
  max-width: 82%;
  margin-bottom: 10rpx;
  padding: 12rpx 18rpx;
  background: #faf7f1;
  border: 1px solid #ddd6c9;
  color: #52565c;
  font-size: 24rpx;
  border-radius: 12rpx;
  white-space: pre-wrap;
}

/* -- composer (one rounded bar: textarea + control row) ------------------ */
.composer {
  flex: 0 0 auto;
  border-top: 1px solid #ddd6c9;
  background: #f2efe9;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
}

/* picked-but-not-yet-sent attachment chips (horizontal strip) */
.previews {
  white-space: nowrap;
  margin-bottom: 12rpx;
}
.chip {
  position: relative;
  display: inline-block;
  vertical-align: top;
  margin-right: 12rpx;
}
.chip-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #faf7f1;
}
.chip-file {
  width: 220rpx;
  height: 96rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  background: #faf7f1;
  border: 1px solid #ddd6c9;
  border-radius: 12rpx;
  overflow: hidden;
}
.chip-name {
  font-size: 22rpx;
  color: #1a1c1e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chip-size {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #52565c;
}
.chip-x {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
}

.bar {
  border: 1px solid #ddd6c9;
  border-radius: 28rpx;
  background: #faf7f1;
  padding: 12rpx 16rpx;
}
.bar.focus {
  border-color: #1e3a6b;
}
.ta {
  width: 100%;
  min-height: 48rpx;
  max-height: 240rpx;
  padding: 4rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.5;
  color: #1a1c1e;
  background: transparent;
}
.input-ph {
  color: #a9a49a;
}
.controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}
.attach {
  flex: 0 0 auto;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: #52565c;
}
/* Subject / model each fill an equal half of the row and center within it. */
/* In the top bar the subject picker sits on the page background, not on the
   composer's white field — the web client draws the same distinction by
   placement, and 44vw is the width it caps that picker at on a phone. */
.tb-center .pill {
  max-width: 44vw;
  background: transparent;
}

/* The model picker's slot: everything between the two 40rpx-ish ends, with the
   picker centred in it. */
.model-slot {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pill {
  max-width: 300rpx;
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  color: #52565c;
  background: #fff;
  border: 1px solid #ddd6c9;
  border-radius: 999rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.send-btn {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 34rpx;
  color: #fff;
  background: #1e3a6b;
  border-radius: 50%;
}
.send-btn.disabled {
  background: #9aa7bd;
}
.send-btn.stop {
  background: #ba1a1a;
  font-size: 26rpx;
}

/* -- left nav drawer ----------------------------------------------------- */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  visibility: hidden;
  transition: opacity 200ms;
  z-index: 1100;
}
.mask.show {
  opacity: 1;
  visibility: visible;
}
.drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 82%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  background: #f2efe9;
  box-shadow: 2px 0 24px rgba(0, 0, 0, 0.18);
  transform: translateX(-100%);
  transition: transform 220ms ease;
  z-index: 1101;
}
.drawer.open {
  transform: translateX(0);
}
.drawer-head {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx;
  padding-top: env(safe-area-inset-top);
}
.drawer-back {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin-left: -12rpx;
  text-align: center;
  font-size: 40rpx;
  color: #52565c;
}
.drawer-title {
  margin-left: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1c1e;
}
/* Two equal-width bordered text buttons (New chat / Incognito). */
.drawer-actions {
  flex: 0 0 auto;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}
.act-btn {
  flex: 1 1 0;
  min-width: 0;
  text-align: center;
  padding: 16rpx 0;
  border: 1px solid #ddd6c9;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1c1e;
}
.act-btn.on {
  color: #1e3a6b;
  border-color: #1e3a6b;
}

/* history is the only scrolling region */
.history {
  flex: 1 1 auto;
  min-height: 0;
  border-top: 1px solid #ddd6c9;
  border-bottom: 1px solid #ddd6c9;
}
.hist-state {
  padding: 48rpx 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: #52565c;
}
.hist-state.tappable {
  color: #ba1a1a;
}
.hist-row {
  display: flex;
  align-items: center;
  border-bottom: 1px solid rgba(196, 199, 203, 0.4);
}
.hist-main {
  flex: 1 1 auto;
  min-width: 0;
  padding: 20rpx 12rpx 20rpx 28rpx;
}
.hist-title {
  font-size: 30rpx;
  color: #1a1c1e;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.hist-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8f96;
}
.hist-del {
  flex: 0 0 auto;
  padding: 20rpx 28rpx;
  font-size: 24rpx;
  color: #ba1a1a;
}

/* pinned footer */
.drawer-foot {
  flex: 0 0 auto;
  border-top: 1px solid #ddd6c9;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}
.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 84rpx;
  padding: 14rpx 28rpx;
  font-size: 30rpx;
  color: #1a1c1e;
}
.nav-row.danger {
  color: #ba1a1a;
  justify-content: center;
}
.nav-hint {
  font-size: 26rpx;
  color: #52565c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.foot-divider {
  height: 1px;
  margin: 4rpx 0;
  background: #ddd6c9;
  opacity: 0.6;
}

/* Account switcher: current email + caret, expanding the other accounts. */
.acct-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 84rpx;
  padding: 14rpx 28rpx;
}
.acct-email {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 26rpx;
  color: #52565c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.acct-caret {
  flex: 0 0 auto;
  font-size: 30rpx;
  color: #52565c;
  transition: transform 150ms;
}
.acct-caret.up {
  transform: rotate(180deg);
}
.acct-item {
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #1a1c1e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* -- font-size tiers (drawer settings "字号") ----------------------------- */
/* WeChat has no rem root to scale like the web client, so the chosen tier is a
   class on .page that scales the message text (the primary content). */
.page.fs-smaller .bubble,
.page.fs-smaller .empty { font-size: 26rpx; }
.page.fs-small .bubble,
.page.fs-small .empty { font-size: 28rpx; }
.page.fs-large .bubble { font-size: 34rpx; }
.page.fs-large .empty { font-size: 34rpx; }
.page.fs-larger .bubble { font-size: 38rpx; }
.page.fs-larger .empty { font-size: 38rpx; }
