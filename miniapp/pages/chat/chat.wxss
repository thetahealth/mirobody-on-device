.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* Message list ----------------------------------------------------------- */
.log {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.empty {
  margin-top: 30vh;
  text-align: center;
  color: #bbb;
  font-size: 30rpx;
}
.row {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}
.row.user {
  align-items: flex-end;
}
.row.assistant {
  align-items: flex-start;
}
.bubble {
  max-width: 78%;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-word;
  white-space: pre-wrap;
}
.bubble.user {
  background: #07c160;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}
.bubble.assistant {
  background: #fff;
  color: #1f1f1f;
  border-bottom-left-radius: 4rpx;
}
.thinking {
  max-width: 78%;
  margin-bottom: 8rpx;
  padding: 12rpx 18rpx;
  background: #efefef;
  color: #888;
  font-size: 24rpx;
  border-radius: 12rpx;
  white-space: pre-wrap;
}

/* Composer --------------------------------------------------------------- */
.composer {
  border-top: 1rpx solid #e5e5e5;
  background: #fafafa;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
.provider {
  margin-bottom: 12rpx;
}
.provider-label {
  display: inline-block;
  max-width: 100%;
  padding: 8rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #555;
}
.input-row {
  display: flex;
  align-items: center;
}
.input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.send {
  margin-left: 16rpx;
  flex-shrink: 0;
}
