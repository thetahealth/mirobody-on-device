<view class="page {{fontClass}}">
  <!-- Toolbar, mirroring the web client's on a phone: the hamburger opens the nav
       drawer with the "Mirobody" wordmark beside it, the centre holds the subject
       picker, and there is no right-hand zone — the settings gear that used to fill
       it is a group inside the drawer now.

       The wordmark and the subject picker are alternatives for one row: nothing
       shared with me -> brand; a care-circle member has -> the picker takes the
       centre and the brand gives way. The empty trailing zone is what keeps that
       picker optically centred against the hamburger. -->
  <view class="toolbar">
    <view class="tb-side">
      <view class="menu-btn" bindtap="openDrawer">☰</view>
      <text wx:if="{{!showSubject}}" class="brand serif">Mirobody</text>
    </view>
    <view class="tb-center">
      <picker
        wx:if="{{showSubject}}"
        mode="selector"
        range="{{subjectNames}}"
        value="{{subjectIndex}}"
        bindchange="onSubjectChange">
        <view class="pill">{{subjectNames[subjectIndex]}}</view>
      </picker>
    </view>
    <view class="tb-side tb-right"></view>
  </view>

  <!-- Message list -->
  <scroll-view
    class="log"
    scroll-y="true"
    scroll-into-view="{{scrollInto}}"
    scroll-with-animation="true">
    <view wx:if="{{messages.length === 0}}" class="empty">
      {{incognito ? '隐私模式：本次对话不会被保存，也不会写入记忆' : '有什么可以帮你的吗？'}}
    </view>
    <view wx:if="{{incognito && messages.length}}" class="incognito-banner">
      隐私模式：本次对话不会被保存
    </view>
    <view
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
      class="row {{item.role}}">
      <view wx:if="{{item.thinking}}" class="thinking">{{item.thinking}}</view>
      <view class="bubble {{item.role}}">{{item.content}}</view>
    </view>
  </scroll-view>

  <!-- Composer. Hidden while the drawer is open because the textarea is a native
       component that would otherwise bleed above the drawer overlay. -->
  <view class="composer" hidden="{{drawerOpen}}">
    <!-- picked-but-not-yet-sent attachments -->
    <scroll-view wx:if="{{attachments.length}}" class="previews" scroll-x="true">
      <view wx:for="{{attachments}}" wx:key="id" class="chip">
        <image wx:if="{{item.isImage}}" class="chip-img" src="{{item.path}}" mode="aspectFill"></image>
        <view wx:else class="chip-file">
          <view class="chip-name">{{item.name}}</view>
          <view class="chip-size">{{item.sizeLabel}}</view>
        </view>
        <view class="chip-x" data-id="{{item.id}}" catchtap="onRemoveAttach">×</view>
      </view>
    </scroll-view>

    <!-- rounded bar: textarea on top, control row below (one composer) -->
    <view class="bar {{barFocus ? 'focus' : ''}}">
      <textarea
        class="ta"
        value="{{input}}"
        placeholder="询问任何问题"
        placeholder-class="input-ph"
        auto-height="true"
        cursor-spacing="24"
        bindinput="onInput"
        bindfocus="onBarFocus"
        bindblur="onBarBlur"></textarea>

      <!-- Control row: attach and Send are the fixed ends, and the model picker
           fills the space between them, centred. The subject picker used to share
           that space; on a phone the web client moves it up into the top bar
           instead, which leaves the model picker alone in the middle and reading
           as centred between two equal-width ends. -->
      <view class="controls">
        <view class="attach" bindtap="onAttach">＋</view>

        <view class="model-slot">
          <picker
            class="provider"
            mode="selector"
            range="{{providers}}"
            range-key="provider"
            value="{{providerIndex}}"
            bindchange="onProviderChange">
            <view class="pill">{{providers.length ? providers[providerIndex].provider : '加载中…'}}</view>
          </picker>
        </view>

        <view
          class="send-btn {{streaming ? 'stop' : ''}} {{(!input && !streaming) ? 'disabled' : ''}}"
          bindtap="onSendOrStop">{{streaming ? '■' : '↑'}}</view>
      </view>
    </view>
  </view>

  <!-- Left nav drawer -->
  <view class="mask {{drawerOpen ? 'show' : ''}}" bindtap="closeDrawer"></view>
  <view class="drawer {{drawerOpen ? 'open' : ''}}">
    <view class="drawer-head">
      <view class="drawer-back" bindtap="closeDrawer">←</view>
      <text class="drawer-title">菜单</text>
    </view>

    <!-- Two equal-width text buttons: New chat and the incognito toggle, matching
         the web client's drawer row. -->
    <view class="drawer-actions">
      <view class="act-btn" bindtap="onNewChat">新对话</view>
      <view class="act-btn {{incognito ? 'on' : ''}}" bindtap="onToggleIncognito">隐私模式</view>
    </view>

    <!-- History (the only scrolling area) -->
    <scroll-view class="history" scroll-y="true">
      <view wx:if="{{historyLoading}}" class="hist-state">加载中…</view>
      <view wx:elif="{{historyError}}" class="hist-state tappable" bindtap="loadHistory">加载失败，点击重试</view>
      <view wx:elif="{{history.length === 0}}" class="hist-state">暂无历史会话</view>
      <block wx:else>
        <view wx:for="{{history}}" wx:key="session_id" class="hist-row">
          <view class="hist-main" data-id="{{item.session_id}}" bindtap="onResume">
            <view class="hist-title">{{item.title}}</view>
            <view wx:if="{{item.time}}" class="hist-time">{{item.time}}</view>
          </view>
          <view class="hist-del" data-id="{{item.session_id}}" catchtap="onDeleteHistory">删除</view>
        </view>
      </block>
    </scroll-view>

    <!-- Pinned footer: health & data (steps sync, care circle) and account. -->
    <view class="drawer-foot">
      <view class="nav-row" bindtap="onSyncSteps">
        <text>微信运动步数同步</text>
        <text class="nav-hint">{{syncing ? '同步中…' : ''}}</text>
      </view>
      <view class="nav-row" bindtap="onOpenCircle">
        <text>关怀圈</text>
      </view>

      <view class="foot-divider"></view>

      <!-- App settings — what the top-bar gear used to hold. The same group the
           login screen's drawer shows on its own. -->
      <settings-rows
        bind:fontchange="onFontChange"
        bind:backendchange="onBackendChange"></settings-rows>

      <view class="foot-divider"></view>

      <!-- Account switcher: the current account's email (muted) with a caret
           that expands the other signed-in accounts (tap to switch) plus an
           "添加账号" row. Mirrors the web client's history.js account block. -->
      <view class="acct-row" bindtap="toggleSwitcher">
        <text class="acct-email">{{accountLabel}}</text>
        <text class="acct-caret {{switcherOpen ? 'up' : ''}}">⌄</text>
      </view>
      <view wx:if="{{switcherOpen}}" class="acct-switcher">
        <view
          wx:for="{{otherAccounts}}"
          wx:key="sub"
          class="acct-item"
          data-sub="{{item.sub}}"
          bindtap="onSwitchAccount">{{item.label}}</view>
        <view class="acct-item" bindtap="onAddAccount">＋  添加账号</view>
      </view>

      <view class="nav-row danger" bindtap="onConfirmSignOut">
        <text>退出登录</text>
      </view>
    </view>
  </view>
</view>
