<view class="chat">
  <!-- Message list -->
  <scroll-view
    class="log"
    scroll-y="true"
    scroll-into-view="{{scrollInto}}"
    scroll-with-animation="true">
    <view wx:if="{{messages.length === 0}}" class="empty">
      有什么可以帮你的吗？
    </view>
    <view
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
      class="row {{item.role}}">
      <view wx:if="{{item.thinking}}" class="thinking">{{item.thinking}}</view>
      <view class="bubble {{item.role}}">{{item.content}}</view>
    </view>
  </scroll-view>

  <!-- Composer -->
  <view class="composer">
    <picker
      class="provider"
      mode="selector"
      range="{{providers}}"
      range-key="name"
      value="{{providerIndex}}"
      bindchange="onProviderChange">
      <view class="provider-label">
        {{providers.length ? providers[providerIndex].name : '加载中…'}}
      </view>
    </picker>

    <view class="input-row">
      <input
        class="input"
        value="{{input}}"
        placeholder="输入消息"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSend" />
      <button
        class="btn-primary send"
        size="mini"
        loading="{{streaming}}"
        disabled="{{streaming || !input}}"
        bindtap="onSend">
        发送
      </button>
    </view>
  </view>
</view>
