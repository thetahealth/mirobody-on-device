<view class="login">
  <!-- Top bar: just the app-settings gear on the right (language / font size /
       backend / about), the same shared <settings-menu> the chat screen shows,
       so settings sit in one consistent place across both screens. -->
  <view class="topbar">
    <settings-menu></settings-menu>
  </view>

  <!-- Brand block: the real mirobody mark, a serif title, and the subtitle,
       aligned to the web client's login (htdoc/src/login.js). -->
  <view class="brand">
    <image
      class="logo"
      mode="aspectFit"
      src="data:image/svg+xml;base64,"
    />
    <view class="title">Mirobody</view>
    <view class="subtitle">登录以继续</view>
  </view>

  <!-- WeChat login: the platform-native primary entry. -->
  <button
    class="btn-wechat"
    loading="{{loading}}"
    disabled="{{loading}}"
    bindtap="onWxLogin">
    微信登录
  </button>

  <view class="divider">
    <view class="line"></view>
    <text class="or">或</text>
    <view class="line"></view>
  </view>

  <!-- Email + one-time code, mirroring the web client's second sign-in flow
       (POST /email/login then /email/verify). -->
  <view class="email-form">
    <input
      class="input"
      type="text"
      placeholder="电子邮箱"
      placeholder-class="input-ph"
      value="{{email}}"
      bindinput="onEmailInput"
    />
    <view class="code-row">
      <input
        class="input code-input {{codeError ? 'input-error' : ''}}"
        type="number"
        maxlength="6"
        placeholder="验证码"
        placeholder-class="input-ph"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <button
        class="btn-send"
        disabled="{{!canSend}}"
        bindtap="onSendCode">
        {{sendLabel}}
      </button>
    </view>
    <button
      class="btn-signin"
      loading="{{verifying}}"
      disabled="{{verifying}}"
      bindtap="onVerify">
      登录
    </button>
  </view>

  <view class="status" wx:if="{{status}}">{{status}}</view>
  <view class="hint">登录即表示同意用户协议与隐私政策</view>
</view>
