/* Login page, aligned to the web client's "Theta Health" design
   (htdoc/src/login.js): warm cream surface, navy primary, near-black serif
   brand title. WeChat login stays the prominent platform-native entry; an
   email + one-time-code form mirrors the web client's second flow. */

.login {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 64rpx 80rpx;
  box-sizing: border-box;
  background: #f2efe9;              /* warm cream page background */
}

/* Top bar holding just the drawer hamburger, on the leading edge (mirrors the
   chat screen's bar). */
.topbar {
  width: 100%;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding-top: env(safe-area-inset-top);
}
.menu-btn {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin-left: -12rpx;
  text-align: center;
  font-size: 40rpx;
  color: #52565c;
}

/* -- settings-only nav drawer -------------------------------------------- */
/* Same scrim + left-anchored panel as the chat drawer (chat.wxss); duplicated
   because a page's wxss is not shared with another page. */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  visibility: hidden;
  transition: opacity 200ms;
  z-index: 1100;
}
.mask.show {
  opacity: 1;
  visibility: visible;
}
.drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 82%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  background: #f2efe9;
  box-shadow: 2px 0 24px rgba(0, 0, 0, 0.18);
  transform: translateX(-100%);
  transition: transform 220ms ease;
  z-index: 1101;
}
.drawer.open {
  transform: translateX(0);
}
.drawer-head {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx;
  padding-top: env(safe-area-inset-top);
}
.drawer-back {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin-left: -12rpx;
  text-align: center;
  font-size: 40rpx;
  color: #52565c;
}
.drawer-title {
  margin-left: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1c1e;
}
.drawer-foot {
  flex: 0 0 auto;
  border-top: 1px solid #ddd6c9;
}

/* Mini Program buttons draw a hairline via ::after and carry default margins;
   reset both so our own borders/radii are the only ones visible. */
button {
  margin: 0;
}
button::after {
  border: none;
}

/* -- brand block --------------------------------------------------------- */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 22vh;
  margin-bottom: 56rpx;
}
.logo {
  width: 108rpx;
  height: 112rpx;
  margin-bottom: 24rpx;
}
.title {
  font-family: Georgia, "Times New Roman", "Songti SC", STSong, serif;
  font-size: 88rpx;
  font-weight: 600;
  line-height: 1.04;
  letter-spacing: -1rpx;
  color: #0f1115;                  /* near-pure black, like the design */
}
.subtitle {
  margin-top: 20rpx;
  font-size: 34rpx;
  color: #52565c;                  /* secondary text */
}

/* -- WeChat button (green, primary platform entry) ----------------------- */
.btn-wechat {
  width: 100%;
  max-width: 620rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  color: #fff;
  background: #07c160;
  border-radius: 20rpx;
}
.btn-wechat[disabled] {
  background: #9be0b8;
  color: #fff;
}

/* -- OR divider ---------------------------------------------------------- */
.divider {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 620rpx;
  margin: 36rpx 0 28rpx;
}
.divider .line {
  flex: 1;
  height: 1px;
  background: #ddd6c9;             /* warm hairline */
}
.divider .or {
  margin: 0 20rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #52565c;
}

/* -- email + one-time code ----------------------------------------------- */
.email-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 620rpx;
}
.input {
  height: 92rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #1a1c1e;
  background: #faf7f1;            /* field fill */
  border: 1px solid #ddd6c9;
  border-radius: 16rpx;
}
.input-ph {
  color: #a9a49a;
}
.input-error {
  border-color: #ba1a1a;
}
.code-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}
.code-input {
  flex: 1;
  min-width: 0;
}
.btn-send {
  flex: 0 0 auto;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  white-space: nowrap;
  color: #1e3a6b;                /* navy link-like */
  background: #faf7f1;
  border: 1px solid #ddd6c9;
  border-radius: 16rpx;
}
.btn-send[disabled] {
  color: #a9a49a;
  background: #f2efe9;
}
.btn-signin {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 4rpx;
  font-size: 32rpx;
  color: #fff;
  background: #1e3a6b;           /* navy primary — matches the web client */
  border-radius: 20rpx;
}
.btn-signin[disabled] {
  background: #9aa7bd;
  color: #fff;
}

/* -- shared status line + footnote --------------------------------------- */
.status {
  margin-top: 24rpx;
  min-height: 1.2em;
  font-size: 26rpx;
  text-align: center;
  color: #52565c;
}
.hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  text-align: center;
  color: #8a8f96;
}
