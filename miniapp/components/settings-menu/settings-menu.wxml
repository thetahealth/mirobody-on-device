<!-- Gear + dropdown, mirroring the web client's SettingsMenu. Rows: language,
     font size, backend address, about (version). Self-contained: it renders its
     own outside-tap mask so it works identically on chat and login. -->
<view class="sm-wrap">
  <view class="gear" bindtap="toggle">⚙</view>
  <view class="menu {{open ? 'show' : ''}}">
    <picker
      mode="selector"
      range="{{langNames}}"
      value="{{langIndex}}"
      bindchange="onLang">
      <view class="row">
        <text>语言</text>
        <text class="hint">{{langLabel}}</text>
      </view>
    </picker>
    <picker
      mode="selector"
      range="{{fontNames}}"
      value="{{fontIndex}}"
      bindchange="onFont">
      <view class="row">
        <text>字号</text>
        <text class="hint">{{fontLabel}}</text>
      </view>
    </picker>
    <view class="row" bindtap="onBackend">
      <text>后端地址</text>
      <text class="hint">{{backendLabel}}</text>
    </view>
    <view class="row" bindtap="onAbout">
      <text>关于</text>
      <text class="hint">{{versionLabel}}</text>
    </view>
  </view>
</view>
<!-- Tap-catcher: closes the menu on an outside tap. -->
<view wx:if="{{open}}" class="mask" catchtap="close"></view>
