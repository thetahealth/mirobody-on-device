/* App-settings gear + dropdown, matching the "Theta Health" design shared with
   chat.wxss (warm cream, navy accents, warm hairlines). */
.sm-wrap {
  position: relative;
}
.gear {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 38rpx;
  color: #52565c;
}
.menu {
  position: absolute;
  top: 66rpx;
  right: 0;
  min-width: 320rpx;
  max-width: 560rpx;
  background: #fff;
  border: 1px solid #ddd6c9;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.16);
  padding: 8rpx;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-6rpx);
  transition: opacity 150ms, transform 150ms;
  z-index: 1201;
}
.menu.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: #1a1c1e;
}
.hint {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 26rpx;
  color: #52565c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
}
