<!-- The app-settings group of the nav drawer: language, font size, backend
     address. Each row carries its current value on the trailing edge, so the
     choice is readable without opening the picker.

     This used to be a gear + dropdown on the right of the top bar. It moved into
     the drawer to follow the web client, which folded the same menu in so every
     screen has one menu affordance instead of a hamburger and a gear competing
     for the same job. With no dropdown there is no outside-tap mask either — the
     drawer that hosts these rows owns dismissal now. -->
<view class="sr">
  <picker
    mode="selector"
    range="{{langNames}}"
    value="{{langIndex}}"
    bindchange="onLang">
    <view class="row">
      <text>语言</text>
      <text class="hint">{{langLabel}}</text>
    </view>
  </picker>
  <picker
    mode="selector"
    range="{{fontNames}}"
    value="{{fontIndex}}"
    bindchange="onFont">
    <view class="row">
      <text>字号</text>
      <text class="hint">{{fontLabel}}</text>
    </view>
  </picker>
  <view class="row" bindtap="onBackend">
    <text>后端地址</text>
    <text class="hint">{{backendLabel}}</text>
  </view>
</view>
