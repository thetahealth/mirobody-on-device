/* App-settings rows, sized to match the drawer's own `.nav-row` in chat.wxss
   (same min-height, padding and type scale) so the settings group reads as one
   list with the health and account rows around it.

   The metrics are duplicated rather than inherited because a WeChat Component is
   style-isolated by default: the host page's `.nav-row` never reaches in here. */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 84rpx;
  padding: 14rpx 28rpx;
  font-size: 30rpx;
  color: #1a1c1e;
}
.hint {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 26rpx;
  color: #52565c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}
