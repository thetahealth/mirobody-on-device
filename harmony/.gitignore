# build-profile.json5 IS tracked, even though DevEco writes the local debug signing block
# into it (cert paths under ~/.ohos plus store/key passwords). Keeping those rewrites out
# of a commit relies on each clone running, once, before opening the project in DevEco:
#     git update-index --skip-worktree harmony/build-profile.json5
# See README.md § Signing. (A .gitignore rule would be a no-op on a tracked file anyway.)
/node_modules
/oh_modules
/local.properties
/.idea
**/build
/.hvigor
.cxx
# Every prebuilt native artifact, from two producers: <abi>/ is the embedded core's
# cross-compiled C++ dependencies (build-prebuilt.cmd/.sh), llama-sdk/<abi>/ is the
# on-device engine (build-llama.cmd/.sh). One rule, because "prebuilt" naming anything
# less than all of them is how a reader ends up assuming the engine is in there.
/prebuilt
# llama.cpp cross-build tree for the on-device engine (build-llama.cmd/.sh). Cached and
# reused across runs, hence kept in-tree rather than in a temp dir; ~24 MB of objects.
# `**/build` above does not catch it — the name neither equals nor starts with "build".
/.llama-build
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer
**/oh-package-lock.json5
