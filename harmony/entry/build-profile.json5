{
  "apiType": "stageMode",
  "buildOption": {
    // Native module (src/main/cpp): the NAPI bridge plus mirobody_core.
    // Device only. Each ABI needs its own cross-compiled dependency tree under
    // harmony/prebuilt/<abi> -- run `build-prebuilt.cmd <abi>` first. Add
    // "x86_64" here (and run the script for it) to also target the emulator.
    //
    // The on-device LLM (src/llm/local.cpp) needs NOTHING here. Run
    // `build-llama.cmd <abi>` (or ./build-llama.sh) and CMakeLists.txt picks the SDK
    // up from harmony/prebuilt/llama-sdk/<abi> by itself, exactly as it picks the C++ deps
    // up from harmony/prebuilt/<abi>. No SDK there is the supported off state: the core
    // compiles its stub and the app still builds, with on-device chat reporting
    // itself unavailable.
    //
    // Only an SDK assembled somewhere else (LLAMA_SDK_DIR) needs naming here:
    //
    //     "arguments": "-DLLAMA_CPP_DIR=<llama-sdk-dir>"
    //
    // hvigor does not expand environment variables in this string and splits it on
    // spaces, so that has to be a literal path with no spaces in it -- and it is
    // machine-local in a TRACKED file, which is exactly what the default location
    // exists to avoid. Prefer the default.
    //
    // CPU only, deliberately: llama.cpp's vulkan backend lost on every axis measured
    // on a Kirin 9020 and cost ~50 MB of shader binary, so it is gone rather than
    // switched off. Numbers and reasoning in build-llama.cmd's header.
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
